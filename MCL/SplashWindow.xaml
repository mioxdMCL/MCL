<Window x:Class="SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Mio Craft Launcher" Width="480" Height="270"
    WindowStyle="None" AllowsTransparency="True" Background="Transparent"
    ShowInTaskbar="False" WindowStartupLocation="CenterScreen" Topmost="True"
    ResizeMode="NoResize">
    <Border CornerRadius="12" BorderThickness="1" BorderBrush="#66FFFFFF" Background="#0B5BCB" ClipToBounds="True">
        <Grid>
            <Image Source="/MCL;component/Images/Heads/MCLSplash.png" Stretch="Fill"/>
            <ProgressBar x:Name="ProgressBar" Height="5" VerticalAlignment="Bottom" Margin="28,0,28,16"
                         Minimum="0" Maximum="100" Value="0" IsIndeterminate="False"
                         Foreground="#FFFFFFFF" Background="#44FFFFFF" BorderThickness="0">
                <ProgressBar.Template>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="2.5"/>
                            <Border x:Name="PART_Track" Background="Transparent"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2.5" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </ProgressBar.Template>
            </ProgressBar>
        </Grid>
    </Border>
</Window>
